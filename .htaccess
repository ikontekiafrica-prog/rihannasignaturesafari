# ==============================================================================
# RIHANNA SIGNATURE SAFARI - APACHE SERVER CONFIGURATION
# HTTPS Enforcement, Canonicalization, SSR Journal Routing, Caching & Security
# ==============================================================================

Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.html index.php

<IfModule mod_mime.c>
  AddType text/plain .txt
  AddType application/xml .xml
  AddType application/json .json
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS (supports direct SSL and reverse-proxy / Cloudflare headers)
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|.*\.test)(:\d+)?$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Canonicalize www to apex domain over HTTPS
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|.*\.test)(:\d+)?$ [NC]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 3. Redirect legacy founder alias to canonical founder page
  RewriteRule ^redempotius-nalisis\.html$ /founder.html [L,R=301]

  # 4. Block access to hidden VCS directories and internal files
  RewriteRule ^\.git - [F,L]
  RewriteRule ^portal/includes/ - [F,L]

  # 5. Serve dynamic SSR pages for Journal & Sitemap (100% bot & AI agent crawlable)
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^blog\.html$ blog.php [L,QSA]
  RewriteRule ^blog-single\.html$ blog-single.php [L,QSA]
  RewriteRule ^journal/([a-zA-Z0-9-]+)/?$ blog-single.php?slug=$1 [L,QSA]
</IfModule>

# Block direct public access to sensitive logs, backups, and config artifacts
<FilesMatch "^(reservations_log\.json|\.htaccess|\.gitattributes|.*\.log|.*\.sql|.*\.bak|.*\.swp)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Security, HSTS, and AI/Crawler Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

  # Keep admin portal private from search indexes
  <If "%{REQUEST_URI} =~ m#^/portal/#">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </If>

  # Allow AI agents & tools to read llms.txt cleanly
  <FilesMatch "^llms(-full)?\.txt$">
    Header set Content-Type "text/plain; charset=UTF-8"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# GZIP Compression for fast Core Web Vitals
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml font/ttf font/woff2
</IfModule>

# Browser Cache Control
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
